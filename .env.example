# ============================================================
# DAWN Cricket Club — Environment Variables
# ============================================================
# --- Site ---
NEXT_PUBLIC_SITE_URL=https://dawn-cricket-club-nsr.vercel.app
NEXT_PUBLIC_SITE_NAME="DAWN Cricket Club"
# ============================================================
# DATABASE (production)
# ============================================================
# Option 1: Leave empty to use SQLite (local dev only)
# Option 2: Set to Neon PostgreSQL URL for persistence
#
# How to get FREE PostgreSQL:
#   1. Sign up at https://neon.tech (free, no credit card)
#   2. Create project "dawn-cricket-club"
#   3. Copy the "Connection string" (starts with postgresql://)
#   4. Paste below
#
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
# --- Google Sheets sync (optional) ---
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
# --- Email (Resend, optional) ---
# RESEND_API_KEY=
# RESEND_FROM="DAWN Cricket Club <noreply@dawncricketclub.pk>"
# --- Auth ---
AUTH_SECRET=dawn-dev-secret-CHANGE-THIS-in-production-please-2026